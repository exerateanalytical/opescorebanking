  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    },
    "schemas": {
      "CreateCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "productRevisionId",
          "feeCode",
          "feeAmountMinor",
          "currency",
          "effectiveFrom",
          "taxPolicyId",
          "waiverPolicyId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "const": 0
          },
          "productRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "feeCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "feeAmountMinor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})$",
            "description": "Canonical nonnegative integer minor-unit decimal string, <=9e15 checked by service"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "taxPolicyId": {
            "type": "string",
            "format": "uuid"
          },
          "waiverPolicyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SubmitCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "feeSimulationEvidenceId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "feeSimulationEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReviewCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "feeApprovalEvidenceId",
          "decision"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2147483647
          },
          "feeApprovalEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT"
            ]
          }
        }
      },
      "CandidateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bankId",
          "aggregateId",
          "domain",
          "version",
          "state",
          "financialEffective",
          "regulatorySubmissionEnabled"
        ],
        "properties": {
          "bankId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "const": "FEE"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "REVIEWED_NOT_EFFECTIVE",
              "REJECTED"
            ]
          },
          "financialEffective": {
            "type": "boolean",
            "const": false
          },
          "regulatorySubmissionEnabled": {
            "type": "boolean",
            "const": false
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "x-statutory-approval": "NOT_VERIFIED",
  "x-stage3-status": "FIELD_SPECIFIC_CANDIDATE_IMPLEMENTATION",
  "x-dependencies": [
    "PRD",
    "LED"
  ]
}
