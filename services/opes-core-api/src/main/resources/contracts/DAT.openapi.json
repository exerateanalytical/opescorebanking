    "/v1/banks/{bankId}/dat/draft-retention-policy": {
      "post": {
        "operationId": "dat_draft_retention_policy",
        "tags": [
          "DAT"
        ],
        "summary": "Data retention and legal hold policy — draft-retention-policy",
        "description": "Trusted bank-scoped candidate operation. Never posts funds, settles a payment, activates entitlement, publishes a regulatory return or enforces policy.",
        "security": [
          {
            "oidc": [
              "banking.write"
            ]
          }
        ],
        "x-domain-id": "DAT",
        "x-required-permission": "dat.draft-retention-policy",
        "x-bank-authority": "SERVER_VERIFIED_OIDC_MEMBERSHIP_PLUS_BANK_DATABASE_PRINCIPAL",
        "x-lifecycle-transition": [
          "NONE",
          "DRAFT"
        ],
        "x-production-status": "BLOCKED_UNTIL_DOMAIN_ACCEPTANCE",
        "parameters": [
          {
            "name": "bankId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "MUST match trusted bank membership; not an authority source"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCandidate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Candidate receipt only: no financial or regulatory effect",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateReceipt"
                }
              }
            }
          },
