  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    },
    "schemas": {
      "CreateCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "customerPartyId",
          "deviceBindingId",
          "channelType",
          "mfaPolicyId",
          "consentEvidenceId",
          "deviceRiskEvidenceId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "const": 0
          },
          "customerPartyId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceBindingId": {
            "type": "string",
            "format": "uuid"
          },
          "channelType": {
            "type": "string",
            "enum": [
              "MOBILE",
              "WEB",
              "CORPORATE",
              "AGENCY"
            ]
          },
          "mfaPolicyId": {
            "type": "string",
            "format": "uuid"
          },
          "consentEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceRiskEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SubmitCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "deviceAttestationId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "deviceAttestationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReviewCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "channelAuthorizationEvidenceId",
          "decision"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2147483647
          },
          "channelAuthorizationEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT"
            ]
          }
        }
      },
      "CandidateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bankId",
          "aggregateId",
          "domain",
          "version",
          "state",
          "financialEffective",
          "regulatorySubmissionEnabled"
        ],
        "properties": {
          "bankId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "const": "CHN"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "REVIEWED_NOT_EFFECTIVE",
              "REJECTED"
            ]
          },
          "financialEffective": {
            "type": "boolean",
            "const": false
          },
          "regulatorySubmissionEnabled": {
            "type": "boolean",
            "const": false
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
