  "paths": {
    "/v1/banks/{bankId}/chn/draft-channel-enrollment": {
      "post": {
        "operationId": "chn_draft_channel_enrollment",
        "tags": [
          "CHN"
        ],
        "summary": "Digital banking channel enrollment — draft-channel-enrollment",
        "description": "Trusted bank-scoped candidate operation. Never posts funds, settles a payment, activates entitlement, publishes a regulatory return or enforces policy.",
        "security": [
          {
            "oidc": [
              "banking.write"
            ]
          }
        ],
        "x-domain-id": "CHN",
        "x-required-permission": "chn.draft-channel-enrollment",
        "x-bank-authority": "SERVER_VERIFIED_OIDC_MEMBERSHIP_PLUS_BANK_DATABASE_PRINCIPAL",
        "x-lifecycle-transition": [
          "NONE",
          "DRAFT"
        ],
        "x-production-status": "BLOCKED_UNTIL_DOMAIN_ACCEPTANCE",
        "parameters": [
          {
            "name": "bankId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "MUST match trusted bank membership; not an authority source"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCandidate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Candidate receipt only: no financial or regulatory effect",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Fail-closed domain error"
          },
          "401": {
            "description": "Fail-closed domain error"
          },
