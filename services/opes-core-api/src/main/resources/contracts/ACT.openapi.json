    "/v1/banks/{bankId}/act/candidates/{aggregateId}": {
      "get": {
        "operationId": "act_get_candidate",
        "security": [
          {
            "oidc": [
              "banking.read"
            ]
          }
        ],
        "x-required-permission": "act.candidate.read",
        "parameters": [
          {
            "name": "bankId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "MUST match trusted bank membership; not an authority source"
          },
          {
            "name": "aggregateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
