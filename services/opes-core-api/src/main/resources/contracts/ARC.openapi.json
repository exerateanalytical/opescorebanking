  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    },
    "schemas": {
      "CreateCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "boundedContext",
          "contractVersion",
          "ownerDomain",
          "compatibilityMode",
          "schemaDigest",
          "architectureDecisionId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "const": 0
          },
          "boundedContext": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "contractVersion": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "ownerDomain": {
            "type": "string",
            "enum": [
              "GOV",
              "SEC",
              "CIF",
              "PRD",
              "ACT",
              "LED",
              "BRN",
              "PAY",
              "CRD",
              "TRE",
              "AML",
              "REP",
              "CHN",
              "CARD",
              "CRM",
              "FEE",
              "REC",
              "DAT",
              "API",
              "INF",
              "DR",
              "ADM",
              "TST",
              "REL",
              "ARC"
            ]
          },
          "compatibilityMode": {
            "type": "string",
            "enum": [
              "BACKWARD",
              "FULL",
              "NONE"
            ]
          },
          "schemaDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "architectureDecisionId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SubmitCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "compatibilityEvidenceId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "compatibilityEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReviewCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "contractApprovalEvidenceId",
          "decision"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2147483647
          },
          "contractApprovalEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT"
            ]
          }
        }
      },
      "CandidateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bankId",
          "aggregateId",
          "domain",
          "version",
          "state",
          "financialEffective",
          "regulatorySubmissionEnabled"
        ],
        "properties": {
          "bankId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "const": "ARC"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "REVIEWED_NOT_EFFECTIVE",
              "REJECTED"
            ]
          },
          "financialEffective": {
            "type": "boolean",
            "const": false
          },
          "regulatorySubmissionEnabled": {
            "type": "boolean",
            "const": false
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "x-statutory-approval": "NOT_VERIFIED",
  "x-stage3-status": "FIELD_SPECIFIC_CANDIDATE_IMPLEMENTATION",
  "x-dependencies": [
