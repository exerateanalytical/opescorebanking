  "components": {
    "schemas": {
      "CorrelationId": {
        "type": "string",
        "format": "uuid"
      },
      "OperationId": {
        "type": "string",
        "format": "uuid"
      },
      "JournalLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "side",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "side": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "postingPurpose": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      },
      "OperationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "institutionId",
          "domain",
          "state",
          "acceptedAt",
          "correlationId"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "enum": [
              "CIF",
              "PRD",
              "ACT",
              "LED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PENDING_APPROVAL",
              "REJECTED",
              "COMPLETED",
              "UNKNOWN_PENDING_RECONCILIATION"
            ]
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ValidateJournal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "journalReference",
          "businessDate",
          "postingRuleRevisionId",
          "lines"
        ],
        "properties": {
          "journalReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "postingRuleRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/JournalLine"
            }
          },
          "sourceEventId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      },
      "PostJournal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validatedJournalId",
          "expectedVersion",
          "postingPolicyRevisionId",
          "checkerDecisionId"
        ],
        "properties": {
          "validatedJournalId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "postingPolicyRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "checkerDecisionId": {
            "type": "string",
            "format": "uuid"
          },
          "accountingPeriodId": {
            "type": "string",
            "format": "uuid"
          },
          "postingDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ReverseJournal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "originalJournalId",
          "correctionReason",
          "authorizationEvidenceId",
          "expectedVersion"
        ],
        "properties": {
          "originalJournalId": {
            "type": "string",
            "format": "uuid"
          },
          "correctionReason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "authorizationEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "sourceIncidentReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    }
  },
  "x-scope-status": "ENGINEERING_DRAFT_NOT_ACCEPTED",
  "x-immutable-financial-policy": "Only LED posts, balances derived, reversals are new journals; uncertain external states never falsely final."
}
