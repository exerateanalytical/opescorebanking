  "components": {
    "schemas": {
      "CorrelationId": {
        "type": "string",
        "format": "uuid"
      },
      "OperationId": {
        "type": "string",
        "format": "uuid"
      },
      "JournalLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "side",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "side": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "postingPurpose": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      },
      "OperationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "institutionId",
          "domain",
          "state",
          "acceptedAt",
          "correlationId"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "enum": [
              "CIF",
              "PRD",
              "ACT",
              "LED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PENDING_APPROVAL",
              "REJECTED",
              "COMPLETED",
              "UNKNOWN_PENDING_RECONCILIATION"
            ]
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productCode",
          "productType",
          "currency",
          "minOpeningAmountMinor",
          "effectiveFrom",
          "name",
          "eligibilityPolicyId"
        ],
        "properties": {
          "productCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
          },
          "productType": {
            "type": "string",
            "enum": [
              "CURRENT",
              "SAVINGS",
              "TERM_DEPOSIT",
              "CREDIT_LINE"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "minOpeningAmountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000000000000000
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "eligibilityPolicyId": {
            "type": "string",
            "format": "uuid"
          },
          "interestRateBasisPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "overdraftPermitted": {
            "type": "boolean"
          },
          "feeScheduleVersionId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ApproveProductVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "revisionId",
          "expectedVersion",
          "decision",
          "reviewEvidenceId"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "revisionId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "reviewEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        }
      },
      "ActivateProductVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "revisionId",
          "expectedVersion",
          "effectiveFrom",
          "releaseApprovalId"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "revisionId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "releaseApprovalId": {
            "type": "string",
            "format": "uuid"
          },
          "migrationPolicy": {
            "type": "string",
            "enum": [
              "NEW_ACCOUNTS_ONLY",
              "FUTURE_EFFECTIVE_TERMS"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
