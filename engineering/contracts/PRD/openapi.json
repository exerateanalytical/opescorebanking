        "operationId": "prd_create_product",
        "tags": [
          "PRD"
        ],
        "summary": "create-product scoped command",
        "description": "Draft typed API contract; authority and maker-checker are enforced by backend, not client-supplied actor ID. No live network settlement or real-money implementation is implied.",
