          {
            "oidc": [
              "banking.write"
            ]
          }
        ],
        "x-permission": "prd.create-product",
        "x-required-scoped-authority": "VERIFIED_TOKEN_SUBJECT_AND_INSTITUTION_MEMBERSHIP",
        "parameters": [
