            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for internal processing; does not mean settlement or posted money.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Unauthorized institution or action"
          },
          "404": {
            "description": "Unknown scoped object"
          },
          "409": {
            "description": "Duplicate idempotency key with changed payload or optimistic version conflict"
          },
          "422": {
            "description": "Invalid lifecycle transition, financial rule, or evidence"
          },
          "503": {
            "description": "Fail-closed unavailable"
          }
        }
      }
