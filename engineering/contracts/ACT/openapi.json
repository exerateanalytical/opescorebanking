  "components": {
    "schemas": {
      "CorrelationId": {
        "type": "string",
        "format": "uuid"
      },
      "OperationId": {
        "type": "string",
        "format": "uuid"
      },
      "JournalLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "side",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "side": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "postingPurpose": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      },
      "OperationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "institutionId",
          "domain",
          "state",
          "acceptedAt",
          "correlationId"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "enum": [
              "CIF",
              "PRD",
              "ACT",
              "LED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PENDING_APPROVAL",
              "REJECTED",
              "COMPLETED",
              "UNKNOWN_PENDING_RECONCILIATION"
            ]
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OpenAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partyId",
          "productRevisionId",
          "currency",
          "kycApprovalEvidenceId",
          "accountPurpose"
        ],
        "properties": {
          "partyId": {
            "type": "string",
            "format": "uuid"
          },
          "productRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "kycApprovalEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "accountPurpose": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "BUSINESS",
              "TREASURY_INTERNAL"
            ]
          },
          "mandateEvidenceRef": {
            "type": "string",
            "format": "uuid"
          },
          "requestedAccountAlias": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "externalCustomerReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          }
        }
      },
      "FreezeAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "expectedVersion",
          "freezeReason",
          "caseReference",
          "reviewRequired"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "freezeReason": {
            "type": "string",
            "enum": [
              "FRAUD_INVESTIGATION",
              "LEGAL_ORDER",
              "CUSTOMER_REQUEST",
              "OPERATIONAL_RISK"
            ]
          },
          "caseReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "reviewRequired": {
            "type": "boolean"
          },
          "releaseNotBefore": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CloseAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "expectedVersion",
          "zeroBalanceEvidenceId",
          "reconciliationEvidenceId",
          "closureReason"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "zeroBalanceEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "reconciliationEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "closureReason": {
            "type": "string",
            "enum": [
              "CUSTOMER_REQUEST",
              "DORMANCY_POLICY",
              "REGULATORY_REQUIREMENT",
              "PRODUCT_RETIRED"
            ]
          },
          "authorizedMandateEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    }
  },
  "x-scope-status": "ENGINEERING_DRAFT_NOT_ACCEPTED",
  "x-immutable-financial-policy": "Only LED posts, balances derived, reversals are new journals; uncertain external states never falsely final."
