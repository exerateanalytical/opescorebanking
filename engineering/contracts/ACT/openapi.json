  "info": {
    "title": "OPES Core Banking — ACT field-specific contract",
    "version": "0.1.0-lab-draft",
    "description": "Domain-specific typed contract, synthetic/integration planning only. Replaces generic payload object for ACT candidate commands. NOT PRODUCTION DoR."
