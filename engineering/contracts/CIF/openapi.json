  "components": {
    "schemas": {
      "CorrelationId": {
        "type": "string",
        "format": "uuid"
      },
      "OperationId": {
        "type": "string",
        "format": "uuid"
      },
      "JournalLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "side",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "side": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "postingPurpose": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      },
      "OperationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "institutionId",
          "domain",
          "state",
          "acceptedAt",
          "correlationId"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "enum": [
              "CIF",
              "PRD",
              "ACT",
              "LED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PENDING_APPROVAL",
              "REJECTED",
              "COMPLETED",
              "UNKNOWN_PENDING_RECONCILIATION"
            ]
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateParty": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partyType",
          "legalName",
          "countryOfResidence",
          "consentEvidenceId",
          "riskTier"
        ],
        "properties": {
          "partyType": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "LEGAL_ENTITY"
            ]
          },
          "legalName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "countryOfResidence": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "incorporationCountry": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "consentEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "riskTier": {
            "type": "string",
            "enum": [
              "LOW",
              "STANDARD",
              "HIGH"
            ]
          },
          "externalPartyReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          }
        }
      },
      "SubmitKyc": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partyId",
          "kycCaseId",
          "identityEvidenceRefs",
          "sanctionsScreeningRef",
          "expectedVersion"
        ],
        "properties": {
          "partyId": {
            "type": "string",
            "format": "uuid"
          },
          "kycCaseId": {
            "type": "string",
            "format": "uuid"
          },
          "identityEvidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "sanctionsScreeningRef": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "riskCaseReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          }
        }
      },
      "ApproveKyc": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partyId",
          "kycCaseId",
          "expectedVersion",
          "decision",
          "evidenceBundleRef",
          "reason"
        ],
        "properties": {
          "partyId": {
            "type": "string",
            "format": "uuid"
          },
          "kycCaseId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT",
              "REQUEST_MORE_EVIDENCE"
            ]
          },
          "evidenceBundleRef": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        }
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    }
  },
  "x-scope-status": "ENGINEERING_DRAFT_NOT_ACCEPTED",
  "x-immutable-financial-policy": "Only LED posts, balances derived, reversals are new journals; uncertain external states never falsely final."
}
