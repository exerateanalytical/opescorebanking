{
  "id": "BRN-020",
  "version": "draft-1",
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "assurance_pack_id": {
        "type": "string",
        "format": "uuid",
        "description": "Review dossier"
      },
      "institution_id": {
        "type": "string",
        "format": "uuid",
        "description": "Target bank"
      },
      "work_package_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "BRN-001 through BRN-019"
      },
      "source_evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Policy and legal authorities"
      },
      "cash_test_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Real physical control tests"
      },
      "ledger_test_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Accounting invariants"
      },
      "security_test_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Access controls"
      },
      "reviewer_roles": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Cash CFO CISO QA"
      },
      "open_findings": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Unresolved blockers"
      },
      "decision_state": {
        "type": "string",
        "description": "Draft blocked accepted"
      }
    }
  },
  "transitions": [
    {
      "from": "DRAFT",
      "to": "IN_REVIEW",
      "guard": "register complete"
    },
    {
      "from": "IN_REVIEW",
      "to": "BLOCKED",
      "guard": "missing P0 evidence"
    },
    {
      "from": "IN_REVIEW",
      "to": "APPROVED",
      "guard": "all gates satisfied"
    },
    {
      "from": "APPROVED",
      "to": "SUPERSEDED",
      "guard": "material scope change"
    },
    {
      "from": "BLOCKED",
      "to": "IN_REVIEW",
      "guard": "new evidence verified"
    }
  ],
  "requirements": [
    "Twenty ZIPs do not mean twenty completed banking capabilities",
    "No cash-related posting passes without PCEC interpretation review",
    "Bank-specific cash/branch licensing evidence must be authentic",
    "No test case is marked passed without execution log",
    "All P0 deficiencies remain listed, not waived",
    "Phase approval has exact reviewer, commit and environment"
  ],
  "release_gate": "Historical WBS reconciliation, physical cash tests, qualified banking reviewers and 15-point DoR controls."
}