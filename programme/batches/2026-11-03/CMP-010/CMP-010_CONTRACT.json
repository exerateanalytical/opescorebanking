{
  "id": "CMP-010",
  "version": "draft-1",
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "acceptance_pack_id": {
        "type": "string",
        "format": "uuid",
        "description": "Review dossier"
      },
      "institution_id": {
        "type": "string",
        "format": "uuid",
        "description": "Licensed bank"
      },
      "package_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Compliance scope"
      },
      "authority_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Primary regulations"
      },
      "screening_evidence_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Source edition proofs"
      },
      "risk_rule_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Approved policies"
      },
      "executed_test_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Real test logs"
      },
      "reviewer_roles": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Compliance legal security QA"
      },
      "open_p0_refs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Critical blockers"
      },
      "decision_state": {
        "type": "string",
        "description": "Draft blocked review accepted"
      }
    }
  },
  "transitions": [
    {
      "from": "DRAFT",
      "to": "IN_REVIEW",
      "guard": "source coverage established"
    },
    {
      "from": "IN_REVIEW",
      "to": "BLOCKED",
      "guard": "missing legal or execution proof"
    },
    {
      "from": "IN_REVIEW",
      "to": "ACCEPTED",
      "guard": "all applicable gates passed"
    },
    {
      "from": "ACCEPTED",
      "to": "SUPERSEDED",
      "guard": "material amendment"
    },
    {
      "from": "BLOCKED",
      "to": "IN_REVIEW",
      "guard": "new independent evidence"
    }
  ],
  "requirements": [
    "Ten ZIP documentation packages are not ten accepted compliance capabilities",
    "No regulator or licensed-institution signoff can be fabricated",
    "A partial AML algorithm does not establish current legal conformity",
    "Historical WP-ACC-005 312/322 conflict still blocks affected reporting mapping",
    "Institution-specific payment permission cannot be inferred from standard message conformance",
    "No test passed without actual execution evidence",
    "All approval decisions carry version, reviewer, legal entity and unresolved exceptions"
  ],
  "release_gate": "Complete historical WBS and legal authority review, actual executed tests, approved bank AML/reporting policies and signed independent acceptance."
}