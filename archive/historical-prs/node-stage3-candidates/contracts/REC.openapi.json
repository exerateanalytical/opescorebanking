  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    },
    "schemas": {
      "CreateCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "statementId",
          "sourceRevisionId",
          "ledgerRevisionId",
          "currency",
          "expectedMinor",
          "observedMinor",
          "breakEvidenceId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "const": 0
          },
          "statementId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "ledgerRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "expectedMinor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})$",
            "description": "Canonical nonnegative integer minor-unit decimal string, <=9e15 checked by service"
          },
          "observedMinor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})$",
            "description": "Canonical nonnegative integer minor-unit decimal string, <=9e15 checked by service"
          },
          "breakEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SubmitCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "independentMatchEvidenceId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "independentMatchEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReviewCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "reconciliationDecisionEvidenceId",
          "decision"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2147483647
          },
          "reconciliationDecisionEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT"
            ]
          }
        }
      },
      "CandidateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bankId",
          "aggregateId",
          "domain",
          "version",
          "state",
          "financialEffective",
          "regulatorySubmissionEnabled"
        ],
        "properties": {
          "bankId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "const": "REC"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "REVIEWED_NOT_EFFECTIVE",
              "REJECTED"
            ]
          },
          "financialEffective": {
            "type": "boolean",
            "const": false
          },
          "regulatorySubmissionEnabled": {
            "type": "boolean",
            "const": false
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
