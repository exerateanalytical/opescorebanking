  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.example.invalid/.well-known/openid-configuration"
      }
    },
    "schemas": {
      "CreateCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "journalReference",
          "businessDate",
          "postingRuleRevisionId",
          "accountingPeriodId",
          "journalLines",
          "sourceEventId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "const": 0
          },
          "journalReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "postingRuleRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "accountingPeriodId": {
            "type": "string",
            "format": "uuid"
          },
          "journalLines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accountId",
                "side",
                "amountMinor",
                "currency"
              ],
              "properties": {
                "accountId": {
                  "type": "string",
                  "format": "uuid"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "DEBIT",
                    "CREDIT"
                  ]
                },
                "amountMinor": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,15}$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              }
            }
          },
          "sourceEventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SubmitCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "doubleEntryValidationEvidenceId"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "doubleEntryValidationEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReviewCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "expectedVersion",
          "journalReviewEvidenceId",
          "decision"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2147483647
          },
          "journalReviewEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT"
            ]
          }
        }
      },
      "CandidateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bankId",
          "aggregateId",
          "domain",
          "version",
          "state",
          "financialEffective",
          "regulatorySubmissionEnabled"
        ],
        "properties": {
          "bankId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "const": "LED"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "REVIEWED_NOT_EFFECTIVE",
              "REJECTED"
            ]
          },
          "financialEffective": {
            "type": "boolean",
            "const": false
          },
          "regulatorySubmissionEnabled": {
            "type": "boolean",
            "const": false
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "x-statutory-approval": "NOT_VERIFIED",
  "x-stage3-status": "FIELD_SPECIFIC_CANDIDATE_IMPLEMENTATION",
  "x-dependencies": [
    "ARC"
  ]
